#!/usr/bin/python3
"""Pick any accent colour for the CaramOS Control Center with GTK's colour chooser.

The Control Center's accent list ends with "Other colour…", which starts this. The chooser opens on the colour
picked last, with the Control Center's own colours as its first row; its "+" button opens the editor for any
colour. Choosing a colour writes it to custom-accent and sets accent-color to "custom"; the Control Center
restyles itself at once. Cancel changes nothing.
"""

from __future__ import annotations

import gettext
import re
import sys

SCHEMA = "net.vietnamlinuxfamily.caramos.control-center"
# The Control Center's colours (applet.js ACCENTS), first row of the chooser.
PRESETS = ("#f59f22", "#3584e4", "#1a9aa0", "#2e9e57", "#8c5dd8", "#d9488b", "#e0353b", "#66707c")
HEX_RE = re.compile(r"^#[0-9a-fA-F]{6}$")


def to_hex(red: float, green: float, blue: float) -> str:
    """#rrggbb of a GdkRGBA's channels (0.0 to 1.0)."""

    return "#" + "".join(f"{round(max(0.0, min(1.0, value)) * 255):02x}" for value in (red, green, blue))


def main() -> int:
    import gi

    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, Gio, Gtk

    source = Gio.SettingsSchemaSource.get_default()
    if source is None or source.lookup(SCHEMA, True) is None:
        print(f"{SCHEMA} is not installed", file=sys.stderr)
        return 1
    settings = Gio.Settings.new(SCHEMA)
    title = gettext.translation("caramos-control-center", "/usr/share/locale", fallback=True).gettext("Accent colour")

    def rgba(text: str) -> Gdk.RGBA:
        colour = Gdk.RGBA()
        colour.parse(text)
        return colour

    dialog = Gtk.ColorChooserDialog(title=title)
    dialog.set_use_alpha(False)
    dialog.set_icon_name("applications-graphics")
    dialog.set_position(Gtk.WindowPosition.CENTER)
    dialog.set_keep_above(True)
    dialog.add_palette(Gtk.Orientation.HORIZONTAL, len(PRESETS), [rgba(colour) for colour in PRESETS])
    current = settings.get_string("custom-accent")
    dialog.set_rgba(rgba(current if HEX_RE.match(current) else PRESETS[0]))
    response = dialog.run()
    if response == Gtk.ResponseType.OK:
        chosen = dialog.get_rgba()
        settings.set_string("custom-accent", to_hex(chosen.red, chosen.green, chosen.blue))
        settings.set_string("accent-color", "custom")
        Gio.Settings.sync()
    dialog.destroy()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
