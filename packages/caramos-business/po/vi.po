#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:562
msgid "Added"
msgstr "Đã thêm"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:580
msgid "Wi-Fi networks"
msgstr "Mạng Wi-Fi"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:580
msgid ""
"Laptops connect by themselves. The password is sealed for each machine and "
"never shown again."
msgstr ""
"Máy xách tay tự kết nối. Mật khẩu được mã hóa riêng cho từng máy và không "
"hiện lại nữa."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:588
msgid "Open network, no password."
msgstr "Mạng mở, không có mật khẩu."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:588
msgid "Password: saved."
msgstr "Mật khẩu: đã lưu."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:589
msgid "Password: new, sent with the next save."
msgstr "Mật khẩu: mới, sẽ gửi khi bạn lưu."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:590
msgid "Password: missing. Type it."
msgstr "Mật khẩu: chưa có. Hãy nhập."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:592
msgid "Hidden network."
msgstr "Mạng ẩn."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:597
msgid "Change password…"
msgstr "Đổi mật khẩu…"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:597
msgid "Type password…"
msgstr "Nhập mật khẩu…"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:609
msgid "Network name (SSID)"
msgstr "Tên mạng (SSID)"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:611
msgid "Password (WPA/WPA2 personal)"
msgstr "Có mật khẩu (WPA/WPA2 cá nhân)"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:611
msgid "Open, no password"
msgstr "Mạng mở, không mật khẩu"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:612
msgid "Hidden network"
msgstr "Mạng ẩn"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:630
msgid "Add a Wi-Fi network"
msgstr "Thêm mạng Wi-Fi"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:631
#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:642
msgid ""
"The password has 8 to 63 letters, digits or signs, without Vietnamese "
"accents."
msgstr ""
"Mật khẩu có từ 8 đến 63 chữ cái, chữ số hoặc ký hiệu, không dấu tiếng Việt."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:635
msgid "New password"
msgstr "Mật khẩu mới"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:641
#, python-format
msgid "Password of %s"
msgstr "Mật khẩu của %s"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:643
msgid "Change"
msgstr "Đổi"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:665
msgid "App Center is not installed on this machine"
msgstr "Máy này chưa có App Center"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:666
msgid "Install App Center to choose apps from its list."
msgstr "Hãy cài App Center để chọn ứng dụng từ danh mục của nó."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:669
msgid "Required"
msgstr "Bắt buộc cài"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:669
msgid "Installed on machines that do not have them."
msgstr "Máy nào chưa có sẽ được cài."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:670
msgid "Not allowed"
msgstr "Không được cài"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:670
msgid "Removed from machines that have them."
msgstr "Máy nào đang có sẽ bị gỡ."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:676
msgid "None."
msgstr "Chưa có."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:679
msgid "Not in App Center's list."
msgstr "Không có trong danh mục của App Center."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:693
msgid "Required apps"
msgstr "Ứng dụng bắt buộc"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:693
msgid "Apps not allowed"
msgstr "Ứng dụng không được cài"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:695
msgid "Search"
msgstr "Tìm"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:735
msgid "Shut down by a schedule"
msgstr "Tắt máy theo lịch"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:737
msgid "Shut the machines down at a set time"
msgstr "Tắt máy vào giờ đã đặt"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:757
#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:802
#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:910
msgid "Time"
msgstr "Giờ"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:761
msgid "Warn before (minutes)"
msgstr "Báo trước (phút)"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:762
msgid "Each postponement (minutes)"
msgstr "Mỗi lần hoãn (phút)"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:763
msgid "Postponements allowed"
msgstr "Số lần được hoãn"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:774
msgid "Laptops"
msgstr "Máy xách tay"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:775
msgid "Leave them on"
msgstr "Để nguyên, không tắt"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:775
msgid "Put them to sleep"
msgstr "Cho ngủ"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:775
msgid "Shut them down too"
msgstr "Tắt như máy bàn"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:787
msgid "Turn on by a schedule"
msgstr "Bật máy theo lịch"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:789
msgid "Turn the machines on at a set time"
msgstr "Bật máy vào giờ đã đặt"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:806
msgid ""
"A machine turns on by itself if it can: before each scheduled shutdown it "
"sets its own wake-up time, and this machine sends a Wake-on-LAN signal over "
"the network cable at that time, so it must be on. Some machines need Wake-on-"
"LAN turned on in their BIOS."
msgstr ""
"Máy tự bật nếu máy hỗ trợ: trước mỗi lần tắt theo lịch, máy tự hẹn giờ bật; "
"đến giờ, máy quản lý gửi tín hiệu Wake-on-LAN qua dây mạng, nên máy quản lý "
"phải đang bật. Một số máy cần bật Wake-on-LAN trong BIOS."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:824
msgid "Allowed"
msgstr "Cho phép"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:825
msgid "Read only"
msgstr "Chỉ đọc"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:825
msgid "Employees can open files on USB drives but cannot copy files onto them."
msgstr "Nhân viên mở được tệp trên USB nhưng không chép tệp vào USB được."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:827
msgid "Blocked"
msgstr "Chặn"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:827
msgid "USB drives do not open."
msgstr "USB không mở được."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:829
msgid ""
"Keyboards, mice, printers and digital signature tokens keep working. To let "
"one machine use USB for a while, open the machine's page."
msgstr ""
"Bàn phím, chuột, máy in và token chữ ký số vẫn dùng được. Muốn cho một máy "
"dùng USB tạm thời, hãy mở trang của máy đó."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:838
msgid "Lock after (minutes without use)"
msgstr "Khóa sau (số phút không dùng)"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:847
msgid "Lock when the machine goes to sleep"
msgstr "Khóa khi máy ngủ"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:859
msgid ""
"Other machines cannot connect to employee machines. Going online, printing "
"and the shared folders work as usual. The firewall can only be turned on "
"from here."
msgstr ""
"Máy khác không kết nối vào máy nhân viên được. Vào mạng, in ấn và thư mục "
"chung vẫn bình thường. Ở đây chỉ bật được tường lửa."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:864
msgid ""
"Machines send their hardware, disks, battery, screens and list of apps, for "
"the asset list. Never files, browsing or anything employees do."
msgstr ""
"Máy gửi thông tin phần cứng, ổ đĩa, pin, màn hình và danh sách ứng dụng để "
"làm danh sách tài sản. Không bao giờ gửi tệp, lịch sử web hay việc nhân viên "
"làm."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:870
msgid "Guest session"
msgstr "Phiên khách"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:871
msgid "A guest session on the login screen"
msgstr "Có phiên khách ở màn hình đăng nhập"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:873
msgid ""
"Anyone can log in without an account. The guest's files are deleted when "
"they log out."
msgstr ""
"Ai cũng đăng nhập được mà không cần tài khoản. Tệp của khách bị xóa khi "
"khách đăng xuất."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:883
msgid "Freeze the machines"
msgstr "Đóng băng máy"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:884
msgid ""
"Every change on a machine is undone when it restarts: files, settings and "
"installed apps. It takes effect at the next restart."
msgstr ""
"Mọi thay đổi trên máy bị xóa khi khởi động lại: tệp, thiết lập và ứng dụng "
"đã cài. Có hiệu lực từ lần khởi động lại tới."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:899
msgid "Maintenance time"
msgstr "Giờ bảo trì"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:899
msgid "A frozen machine takes its updates only then."
msgstr "Máy đóng băng chỉ nhận bản cập nhật vào giờ này."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:915
msgid "Longest maintenance (minutes)"
msgstr "Bảo trì lâu nhất (phút)"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:929
msgid "Machines with little memory"
msgstr "Máy ít bộ nhớ"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:932
#, python-format
msgid ""
"%(names)s has less than 3 GB of memory: frozen, it keeps every change in "
"memory and may slow down."
msgid_plural ""
"%(names)s have less than 3 GB of memory: frozen, they keep every change in "
"memory and may slow down."
msgstr[0] ""
"%(names)s có dưới 3 GB bộ nhớ: khi đóng băng, mọi thay đổi nằm trong bộ nhớ "
"nên máy có thể chậm."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:935
msgid "Freeze machines with less than 3 GB of memory too"
msgstr "Vẫn đóng băng máy có dưới 3 GB bộ nhớ"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:937
msgid "Without this, such machines are not frozen and say why."
msgstr "Nếu không bật, các máy này không đóng băng và báo lý do."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:946
msgid ""
"Freezing cannot be on together with system snapshots, or with tidying "
"Desktop and Documents onto the server: saving refuses it. Remind people to "
"keep their files on the shared drive or a USB drive."
msgstr ""
"Không bật được đóng băng cùng lúc với bản lưu hệ thống, hay với dọn Màn hình "
"nền và Tài liệu lên máy chủ: khi lưu sẽ bị từ chối. Hãy nhắc mọi người lưu "
"tệp vào ổ dùng chung hoặc USB."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:972
msgid "Take a snapshot"
msgstr "Chụp bản lưu"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:973
msgid "Every week"
msgstr "Hằng tuần"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:973
msgid "Every month"
msgstr "Hằng tháng"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:983
msgid "Snapshots to keep"
msgstr "Số bản lưu giữ lại"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:992
msgid "One more snapshot before each update"
msgstr "Chụp thêm một bản trước mỗi lần cập nhật"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:1001
msgid "Not a backup"
msgstr "Không phải bản sao lưu"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:1002
msgid "Snapshots are on the same disk as the system"
msgstr "Bản lưu nằm trên cùng ổ đĩa với hệ thống"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:1003
msgid ""
"If the disk breaks, the snapshots are lost with it. They hold the system, "
"not people's files: keep files on the server, and back them up elsewhere."
msgstr ""
"Ổ đĩa hỏng thì mất luôn các bản lưu. Bản lưu chỉ gồm hệ thống, không gồm tệp "
"của mọi người: hãy để tệp trên máy chủ và sao lưu ở nơi khác."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:1005
msgid "Going back to a snapshot"
msgstr "Quay lại một bản lưu"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:1006
msgid ""
"On the machine itself, open the Timeshift app and choose a snapshot. The "
"guide explains each step."
msgstr ""
"Ngay trên máy đó, mở ứng dụng Timeshift rồi chọn một bản lưu. Hướng dẫn có "
"giải thích từng bước."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:1008
msgid "Disk space"
msgstr "Dung lượng ổ đĩa"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:1009
msgid ""
"The first snapshot takes about as much space as the system; later ones only "
"what changed. The Security report shows how much each machine uses."
msgstr ""
"Bản lưu đầu tiên chiếm chỗ gần bằng hệ thống; các bản sau chỉ thêm phần thay "
"đổi. Báo cáo an toàn cho biết mỗi máy dùng bao nhiêu."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:1017
#, python-format
msgid ""
"At %(time)s on %(days)s this machine wakes the frozen machines; each one "
"restarts unfrozen, takes its updates and the company's apps, then restarts "
"frozen again. When someone is using a machine, it tries again every 15 "
"minutes for up to %(minutes)d minutes, then skips the day."
msgstr ""
"Lúc %(time)s các ngày %(days)s, máy này đánh thức các máy đóng băng; mỗi máy "
"khởi động lại ở chế độ bảo trì, nhận bản cập nhật và ứng dụng của công ty, "
"rồi khởi động lại và đóng băng như cũ. Nếu có người đang dùng máy, máy thử "
"lại mỗi 15 phút trong tối đa %(minutes)d phút, rồi bỏ qua hôm đó."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:1020
#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:1031
msgid "no day"
msgstr "không ngày nào"

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:1030
#, python-format
msgid "At %(time)s on %(days)s the machines shut down."
msgstr "Máy tắt lúc %(time)s, %(days)s."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:1035
#, python-format
msgid ""
"%(warn)d minutes before, whoever is using a machine sees a countdown and can "
"postpone by %(postpone)d minutes, once."
msgid_plural ""
"%(warn)d minutes before, whoever is using a machine sees a countdown and can "
"postpone by %(postpone)d minutes, up to %(times)d times."
msgstr[0] ""
"Trước %(warn)d phút, người đang dùng máy thấy đồng hồ đếm ngược và có thể "
"hoãn %(postpone)d phút, tối đa %(times)d lần."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:1041
#, python-format
msgid "%d minutes before, whoever is using a machine sees a countdown."
msgstr "Trước %d phút, người đang dùng máy thấy đồng hồ đếm ngược."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:1042
msgid "A machine nobody is logged in to shuts down at once."
msgstr "Máy không ai đăng nhập thì tắt luôn."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:1044
msgid "Laptops stay on."
msgstr "Máy xách tay không bị tắt."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:1044
msgid "Laptops go to sleep instead."
msgstr "Máy xách tay được cho ngủ thay vì tắt."

#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:1045
msgid "Laptops shut down too."
msgstr "Máy xách tay cũng tắt."

#: usr/lib/python3/dist-packages/caramos_business/ui/settings_page.py:28
msgid ""
"One wallpaper for every machine, pictures for holidays, and whether "
"employees may change it."
msgstr ""
"Một hình nền cho mọi máy, ảnh riêng cho ngày lễ, và có cho nhân viên đổi hay "
"không."

#: usr/lib/python3/dist-packages/caramos_business/ui/settings_page.py:29
msgid ""
"Each employee's Desktop and Documents in their own folder on the company's "
"server or NAS."
msgstr ""
"Desktop và Tài liệu của mỗi nhân viên nằm trong thư mục riêng trên máy chủ "
"hoặc NAS của công ty."

#: usr/lib/python3/dist-packages/caramos_business/ui/settings_page.py:30
msgid "The company's shared folders, ready in every employee's file manager."
msgstr ""
"Các thư mục chung của công ty có sẵn trong trình quản lý tệp của mọi nhân "
"viên."

#: usr/lib/python3/dist-packages/caramos_business/ui/settings_page.py:31
msgid ""
"Home page, bookmarks, websites blocked during working hours and safe search, "
"for Firefox, Chrome, Cốc Cốc, Edge and Brave."
msgstr ""
"Trang chủ, dấu trang, chặn trang web trong giờ làm việc và tìm kiếm an toàn, "
"cho Firefox, Chrome, Cốc Cốc, Edge và Brave."

#: usr/lib/python3/dist-packages/caramos_business/ui/settings_page.py:33
msgid "Network printers set up on the machines."
msgstr "Máy in mạng được cài sẵn trên các máy."

#: usr/lib/python3/dist-packages/caramos_business/ui/settings_page.py:34
msgid ""
"Machines join the company's Wi-Fi by themselves. The password is sealed for "
"each machine."
msgstr ""
"Máy tự kết nối Wi-Fi của công ty. Mật khẩu được mã hóa riêng cho từng máy."

#: usr/lib/python3/dist-packages/caramos_business/ui/settings_page.py:35
msgid "Apps from App Center's list that must be installed, or must not be."
msgstr ""
"Ứng dụng trong danh mục của App Center phải được cài, hoặc không được cài."

#: usr/lib/python3/dist-packages/caramos_business/ui/settings_page.py:36
msgid ""
"Shut machines down at the end of the day and turn them on in the morning."
msgstr "Tắt máy cuối ngày và bật lại vào buổi sáng."

#: usr/lib/python3/dist-packages/caramos_business/ui/settings_page.py:37
msgid "USB storage, locking the screen, and the firewall."
msgstr "USB lưu trữ, tự khóa màn hình và tường lửa."

#: usr/lib/python3/dist-packages/caramos_business/ui/settings_page.py:38
msgid ""
"For machines many people use, in a computer lab, a meeting room or at the "
"front desk: a guest session, and freezing, which undoes every change when "
"the machine restarts."
msgstr ""
"Cho các máy nhiều người cùng dùng, ở phòng máy, phòng họp hay quầy lễ tân: "
"phiên khách, và đóng băng để mọi thay đổi bị xóa khi khởi động lại."

#: usr/lib/python3/dist-packages/caramos_business/ui/settings_page.py:40
