#!/bin/sh

# postinst script for veyon-service
#
# see: dh_installdeb(1)

# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <postinst> `abort-remove'
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see http://www.debian.org/doc/debian-policy/ or
# the debian-policy package

set -e

AUTH_HELPER=/usr/bin/veyon-auth-helper

case "$1" in
	configure)
		# Since Veyon 4.11, veyon-auth-helper is a D-Bus activated systemd
		# service and must not be setuid root. veyon-service up to 4.9 made it
		# setuid with a statoverride: drop that one, and give the helper the
		# mode of the package back, as dpkg unpacked the new helper with the
		# statoverride it had read before the upgrade. A statoverride that an
		# administrator set is left alone.
		override="$(dpkg-statoverride --list "$AUTH_HELPER" 2>/dev/null || true)"
		if [ "$override" = "root root 4755 $AUTH_HELPER" ]; then
			dpkg-statoverride --remove "$AUTH_HELPER"
			override=""
		fi
		if [ -z "$override" ] && [ -u "$AUTH_HELPER" ]; then
			chmod 0755 "$AUTH_HELPER"
		fi

		mkdir -p "/etc/veyon/"
		mkdir -p "/etc/xdg/Veyon Solutions/"
		;;

	abort-upgrade|abort-remove|abort-deconfigure)
		;;

	*)
		echo "postinst called with unknown argument \`$1'" >&2
		exit 1
		;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
