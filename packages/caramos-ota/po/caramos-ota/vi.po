msgstr "Trung tâm cập nhật không cài được bản cập nhật “%s”."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/problem.py:65
msgid "The Update Center could not install the update."
msgstr "Trung tâm cập nhật không cài được bản cập nhật."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/auto_update.py:189
