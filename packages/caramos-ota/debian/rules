#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_build:
	./tools/caramos-ota-testkit.sh compile

override_dh_auto_test:
	./tools/caramos-ota-testkit.sh validate
	./tools/caramos-ota-testkit.sh test

override_dh_install:
	chmod 0644 debian/install
	dh_install

# Canon's printer daemon and its plug-in setup (Driver Check's canon_capt.py) run only on computers where the user
# installed Canon's driver, which adds the daemon to multi-user.target itself. Never start them from this package,
# nor stop the daemon on each upgrade (without --no-stop-on-upgrade, --no-start stops it in preinst): a print job
# would stop, and the printers would stay off until the next boot.
# caramos-ota-dconf-update.service runs `dconf update` at a start, before anyone logs in, when an update left it for
# then (caramos_ota_update/deferred.py): enabled, and never started from here, as Cinnamon dies under `dconf update`.
# caramos-ota-boot-update.service installs, at a start before anyone can log in, an update that waited for open
# desktops (caramos_ota/auto_update.py, boot_run): enabled, never started or stopped from here. Its update may
# install this package itself, so a stop in the preinst would wait for its own unit.
# The daily check updates this package itself (its self-update), from inside caramos-ota-check.service: its upgrade
# must neither stop nor start that unit or its timer and wait for it. A start or restart of the timer while a shutdown
# or `systemctl stop` waits for the check (KillMode=mixed, caramos_ota/stopping.py) is ordered after the check's stop,
# which waits for this postinst: both waited until TimeoutStopSec and dpkg was killed. Here nothing is started or
# stopped; the postinst enables the timer and starts it without waiting (systemctl --no-block).
override_dh_installsystemd:
	dh_installsystemd --no-start --no-stop-on-upgrade caramos-ota-check.service caramos-ota-check.timer
	dh_installsystemd caramos-boot-success.timer
	dh_installsystemd --no-start --no-stop-on-upgrade caramos-canon-capt.service caramos-canon-capt-setup.service
	dh_installsystemd --no-start --no-stop-on-upgrade caramos-ota-dconf-update.service
	dh_installsystemd --no-start --no-stop-on-upgrade caramos-ota-boot-update.service
