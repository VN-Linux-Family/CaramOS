#!/usr/bin/env bash
echo "Cài Zalo..."
set -e

# Hook này chỉ tạo launcher + icon. File Zalo.AppImage (từ VN-Linux-Family/zalo-for-linux) do OTA
# migration 20261005110000_update_zalo_appimage tải và kiểm tra sha256 khi build.sh chạy OTA bootstrap
# trong rootfs, nên ISO mới và máy đã cài dùng chung một bản Zalo. Đổi bản Zalo: thêm migration mới.

APP_NAME="Zalo"

INSTALL_DIR="/usr/local/bin"
APPIMAGE_PATH="$INSTALL_DIR/Zalo.AppImage"

DESKTOP_FILE="/usr/share/applications/zalo.desktop"
ICON_PATH="/usr/share/pixmaps/zalo.png"

echo "==> Kiểm tra quyền root"

if [ "$EUID" -ne 0 ]; then
    echo "Vui lòng chạy bằng sudo"
    exit 1
fi

echo "==> Tạo thư mục"
mkdir -p "$INSTALL_DIR"

echo "==> Tải icon"
wget -O "$ICON_PATH" "https://upload.wikimedia.org/wikipedia/commons/9/91/Icon_of_Zalo.svg"

echo "==> Tạo shortcut .desktop"

cat > "$DESKTOP_FILE" <<EOF
[Desktop Entry]
Name=Zalo
Comment=Unemployed or Nightmare everyday?
Exec=$APPIMAGE_PATH
Icon=$ICON_PATH
Terminal=false
Type=Application
Categories=Network;Chat;
StartupNotify=true
EOF

chmod +x "$DESKTOP_FILE"

echo "==> Cập nhật database ứng dụng"
update-desktop-database /usr/share/applications 2>/dev/null || true

echo ""
echo "Cài đặt hoàn tất."
echo "Mở Zalo từ taskbar hoặc menu ứng dụng."
