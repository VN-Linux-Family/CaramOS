[Unit]
Description=Save today's photo of Vietnam for System Settings > Backgrounds (CaramOS)
# Desktop users only: not the login screen's account or other system accounts.
ConditionUser=!@system
# Not in the live session of the USB stick: its photos would be gone at shutdown.
ConditionKernelCommandLine=!boot=casper

[Service]
Type=oneshot
ExecStart=/usr/bin/caramos-daily-wallpaper
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=10min
