# CaramOS: Canon CAPT printers that captdriver does not drive (knowledge.CAPT_PRINTERS less CAPTDRIVER_MODELS).
# They work only through Canon's own driver, whose daemon (ccpd) opens /dev/usb/lpN: keep the CUPS USB backend
# from taking them over (it unbinds usblp whenever it probes a printer), and from listing them as printers it
# could drive.
# LBP810
0x04a9 0x260a blacklist
# LBP1210
0x04a9 0x2617 blacklist
# LBP1120
0x04a9 0x262b blacklist
# LBP3200
0x04a9 0x2636 blacklist
