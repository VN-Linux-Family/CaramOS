msgstr "Đã cài xong driver"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/install.py:157
msgid "Restart the computer to start using it."
msgstr "Khởi động lại máy để bắt đầu dùng."

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/install.py:158
msgid "It is working already; no restart needed."
msgstr "Driver đã chạy, không cần khởi động lại."

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/install.py:161
msgid "The driver was not installed"
msgstr "Chưa cài được driver"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/install.py:173
msgid "Restart now"
msgstr "Khởi động lại ngay"

