msgid "The firewall can only be turned on by the company."
msgstr "Công ty chỉ bật được tường lửa, không tắt."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:525
msgid "The inventory is turned on with enabled: true; off is null."
msgstr "Kiểm kê được bật bằng enabled: true; tắt là null."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:529
msgid "At most 10 Wi-Fi networks."
msgstr "Tối đa 10 mạng Wi-Fi."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:531
#: usr/lib/python3/dist-packages/caramos_business/protocol.py:535
#: usr/lib/python3/dist-packages/caramos_business/protocol.py:536
