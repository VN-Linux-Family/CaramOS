msgid "At most 50 bookmarks."
msgstr "Tối đa 50 dấu trang."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:442
msgid "Each bookmark needs a name of at most 60 characters."
msgstr "Mỗi dấu trang cần một tên, tối đa 60 ký tự."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:443
msgid "A bookmark's address is not a web address."
msgstr "Địa chỉ của một dấu trang không phải địa chỉ web."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:444
#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:371
msgid "At most 500 blocked websites."
msgstr "Tối đa 500 trang web bị chặn."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:446
#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:364
#, python-format
msgid "“%s” is not a website name such as facebook.com."
msgstr "“%s” không phải tên trang web như facebook.com."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:447
msgid "A website is listed twice."
msgstr "Một trang web bị ghi hai lần."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:450
msgid "The blocking hours are not valid."
msgstr "Giờ chặn không hợp lệ."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:451
#: usr/lib/python3/dist-packages/caramos_business/protocol.py:483
#: usr/lib/python3/dist-packages/caramos_business/protocol.py:492
msgid "Choose at least one day."
msgstr "Hãy chọn ít nhất một ngày."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:453
msgid "Give one to six time ranges."
msgstr "Hãy ghi từ một đến sáu khoảng giờ."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:456
#: usr/lib/python3/dist-packages/caramos_business/protocol.py:484
#: usr/lib/python3/dist-packages/caramos_business/protocol.py:493
msgid "Write times as HH:MM, such as 08:00."
msgstr "Ghi giờ theo dạng GG:PP, ví dụ 08:00."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:458
msgid "A time range ends after it starts, on the same day."
msgstr "Một khoảng giờ phải kết thúc sau lúc bắt đầu, trong cùng một ngày."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:463
msgid "At most 20 printers."
msgstr "Tối đa 20 máy in."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:466
#: usr/lib/python3/dist-packages/caramos_business/protocol.py:472
msgid "The printers are not valid."
msgstr "Danh sách máy in không hợp lệ."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:468
msgid "Each printer needs a name of at most 60 characters."
msgstr "Mỗi máy in cần một tên, tối đa 60 ký tự."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:470
msgid ""
"A printer's address starts with ipp:// or ipps://, such as "
"ipp://192.168.1.50/ipp/print."
msgstr ""
"Địa chỉ máy in bắt đầu bằng ipp:// hoặc ipps://, ví dụ ipp://192.168.1.50/"
"ipp/print."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:471
msgid "A location is longer than 60 characters."
msgstr "Có vị trí dài quá 60 ký tự."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:474
msgid "Only one printer can be the default."
msgstr "Chỉ một máy in được là mặc định."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:475
msgid "Two printers have the same name."
msgstr "Có hai máy in trùng tên."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:479
#: usr/lib/python3/dist-packages/caramos_business/protocol.py:482
#: usr/lib/python3/dist-packages/caramos_business/protocol.py:488
#: usr/lib/python3/dist-packages/caramos_business/protocol.py:491
msgid "The power schedule is not valid."
msgstr "Lịch bật/tắt máy không hợp lệ."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:485
msgid "The warning comes 1 to 30 minutes before."
msgstr "Báo trước từ 1 đến 30 phút."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:486
msgid "A postponement is 5 to 120 minutes."
msgstr "Mỗi lần hoãn từ 5 đến 120 phút."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:487
msgid "At most 5 postponements."
msgstr "Tối đa 5 lần hoãn."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:497
msgid "The app settings are not valid."
msgstr "Thiết lập ứng dụng không hợp lệ."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:500
#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:708
msgid "At most 50 apps in each list."
msgstr "Mỗi danh sách tối đa 50 ứng dụng."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:501
msgid "An app is not in the App Center's list."
msgstr "Có ứng dụng không nằm trong danh mục của App Center."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:503
msgid "An app is listed twice."
msgstr "Một ứng dụng bị ghi hai lần."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:505
msgid "An app cannot be both required and forbidden."
msgstr "Một ứng dụng không thể vừa bắt buộc vừa bị cấm."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:509
msgid "The USB setting is not valid."
msgstr "Thiết lập USB không hợp lệ."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:513
#: usr/lib/python3/dist-packages/caramos_business/protocol.py:515
msgid "The screen lock settings are not valid."
msgstr "Thiết lập khóa màn hình không hợp lệ."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:514
