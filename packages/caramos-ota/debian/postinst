#!/bin/sh
set -e

case "$1" in
    configure)
        # Create runtime directories
        mkdir -p /var/lib/caramos-ota
        mkdir -p /var/log/caramos-ota

        # Ensure root ownership
        chown root:root /var/lib/caramos-ota
        chmod 0755 /var/lib/caramos-ota
        chown root:root /var/log/caramos-ota
        chmod 0755 /var/log/caramos-ota

        # Enable and start the daily check timer
        if command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload || true
            systemctl enable caramos-ota-check.timer || true
            systemctl start caramos-ota-check.timer || true
        fi

        # Files (Nemo): right-click > "Mới" > "Thư mục" from the next login (see the script).
        /usr/share/caramos-ota/nemo-menu/caramos-nemo-menu || true

        # The office defaults of 1.4.0 and 1.5.0 (see preinst): delete the unchanged /etc/xdg/mimeapps.list that
        # preinst moved aside, and the copy of that list a failed configure left (the .dpkg-new file of ticket H-1207).
        # The checksum is that list's; any other file stays.
        rm -f "$DPKG_ROOT/etc/xdg/mimeapps.list.dpkg-remove" || true
        stale="$DPKG_ROOT/etc/xdg/mimeapps.list.dpkg-new"
        if [ -f "$stale" ] && [ ! -L "$stale" ] \
                && [ "$(md5sum < "$stale" 2>/dev/null | cut -d ' ' -f 1)" = 656282d52d81c53509c4b22f05ebdd66 ]; then
            rm -f "$stale" || true
        fi
        ;;
    triggered)
        # A Cinnamon update put back its own panel files: make the CaramOS changes again. A failure is
        # logged in /var/log/caramos-ota and must not fail the Cinnamon update.
        python3 -I -m caramos_ota_update.cinnamon_patches || true
        # A Nemo update: the "Mới > Thư mục" menus are written again from its library.
        /usr/share/caramos-ota/nemo-menu/caramos-nemo-menu || true
        ;;
esac

#DEBHELPER#

exit 0
