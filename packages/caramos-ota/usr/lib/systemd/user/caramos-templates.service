[Unit]
Description=Put the document templates of Files > right-click > New into the Templates folder (CaramOS)
ConditionUser=!@system
# Each set of templates is put in once and recorded (see the script): run while one record is missing.
ConditionPathExists=|!%h/.local/state/caramos/templates.json
ConditionPathExists=|!%h/.local/state/caramos/templates-nd30.json

[Service]
Type=oneshot
ExecStart=/usr/share/caramos-ota/nemo-menu/caramos-templates
