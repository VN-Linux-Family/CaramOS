msgid "At most 20 shared drives."
msgstr "Tối đa 20 ổ dùng chung."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:425
msgid "The shared drives are not valid."
msgstr "Danh sách ổ dùng chung không hợp lệ."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:427
msgid "Each shared drive needs a name of at most 60 characters."
msgstr "Mỗi ổ dùng chung cần một tên, tối đa 60 ký tự."

