#!/usr/bin/python3
"""Tell GRUB this boot went well, once someone has been on the desktop for a minute.

GRUB marks each boot as unfinished (recordfail=1 in /boot/grub/grubenv) and shows its menu, for 30 seconds, after
a boot that was never marked as done: the menu with "Advanced options for CaramOS" and the recovery mode, which
the hidden menu (GRUB_TIMEOUT_STYLE=hidden, GRUB_TIMEOUT=0) otherwise keeps out of reach. Ubuntu marks the boot as
done as soon as the system is up (grub-common.service), even when the screen stays black. CaramOS waits for a
graphical session of a user that has lasted MIN_SESSION_SECONDS, then clears the mark; until then
grub-common.service waits (its drop-in caramos-boot-success.conf), so a boot that never reached the desktop
brings the menu back. caramos-boot-success.timer runs this every 30 seconds until it succeeds.
"""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path

GRUBENV = Path("/boot/grub/grubenv")
FLAG = Path("/run/caramos-boot-success")
UPTIME = Path("/proc/uptime")
MIN_SESSION_SECONDS = 60
GRAPHICAL = {"x11", "wayland", "mir"}
TIMER = "caramos-boot-success.timer"


def run(*args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(list(args), check=False, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)


def sessions() -> list[dict[str, str]]:
    listed = run("loginctl", "list-sessions", "--no-legend", "--no-pager")
    found = []
    for line in listed.stdout.splitlines():
        fields = line.split()
        if not fields:
            continue
        shown = run("loginctl", "show-session", fields[0], "--no-pager",
                    "-p", "Class", "-p", "Type", "-p", "Remote", "-p", "TimestampMonotonic")
        found.append(dict(item.split("=", 1) for item in shown.stdout.splitlines() if "=" in item))
    return found


def desktop_reached(uptime: float, found: list[dict[str, str]]) -> bool:
    """Whether a local graphical session of a user started at least MIN_SESSION_SECONDS ago."""

    for session in found:
        if session.get("Class") != "user" or session.get("Type") not in GRAPHICAL or session.get("Remote") == "yes":
            continue
        try:
            started = int(session.get("TimestampMonotonic") or 0) / 1_000_000
        except ValueError:
            continue
        if started > 0 and uptime - started >= MIN_SESSION_SECONDS:
            return True
    return False


def main() -> int:
    if FLAG.exists():
        return 0
    uptime = float(UPTIME.read_text(encoding="ascii").split()[0])
    if not desktop_reached(uptime, sessions()):
        return 0
    # grub-common.service would have (re)created an empty or missing grubenv; GRUB can only save to one that exists.
    if not GRUBENV.is_file() or GRUBENV.stat().st_size == 0:
        GRUBENV.unlink(missing_ok=True)
        run("grub-editenv", str(GRUBENV), "create")
    result = run("grub-editenv", str(GRUBENV), "unset", "recordfail")
    if result.returncode != 0:
        print(f"grub-editenv failed: {result.stderr.strip()}", file=sys.stderr)
        return 1
    FLAG.touch()
    print("the desktop was reached: GRUB keeps its menu hidden at the next boot")
    run("systemctl", "--no-block", "stop", TIMER)
    return 0


if __name__ == "__main__":
    sys.exit(main())
