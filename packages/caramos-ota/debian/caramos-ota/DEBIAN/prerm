#!/bin/sh
set -e

case "$1" in
    remove|deconfigure)
        # Stop and disable the timer on removal
        if command -v systemctl >/dev/null 2>&1; then
            systemctl stop caramos-ota-check.timer || true
            systemctl disable caramos-ota-check.timer || true
        fi
        ;;
esac

# Automatically added by dh_installsystemd/13.6ubuntu1
if [ -z "${DPKG_ROOT:-}" ] && [ "$1" = remove ] && [ -d /run/systemd/system ] ; then
	deb-systemd-invoke stop 'caramos-ota-check.service' 'caramos-ota-check.timer' >/dev/null || true
fi
# End automatically added section


exit 0
