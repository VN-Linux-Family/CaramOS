msgid ""
"This enrolment file has expired, has been used up, or was withdrawn: pair "
"this machine with a code."
msgstr ""
"Tệp ghép máy đã hết hạn, hết lượt hoặc đã bị thu hồi: hãy ghép máy này bằng "
"mã."

#: usr/lib/python3/dist-packages/caramos_business/pairing.py:383
msgid ""
"The admin machine did not accept this enrolment file. Check the date and "
"time of this machine."
msgstr ""
"Máy quản lý không nhận tệp ghép máy này. Hãy kiểm tra ngày giờ của máy này."

#: usr/lib/python3/dist-packages/caramos_business/pairing.py:391
