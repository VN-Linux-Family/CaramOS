# Cấu hình VM test riêng của từng dev. Copy thành vm.local.env (đã git-ignore) rồi sửa.
# Mỗi dòng là KEY=value, không dấu nháy, không khoảng trắng quanh giá trị.
# Biến môi trường / tham số dòng lệnh (make vm-reset BASE=1.0.12) luôn thắng file này.

# Bản CaramOS làm nền. Domain libvirt mặc định là caram<BASE>, ISO mặc định là
# <repo>/CaramOS-<BASE>-cinnamon-amd64.iso
BASE=1.0.16

# Đặt tên domain khác nếu không theo quy ước caram<BASE>
#VM_DOMAIN=caram1.0.16

# Snapshot dùng cho make vm-snapshot / make vm-reset
#VM_SNAPSHOT=clean

# User đăng nhập trong VM (user tạo lúc cài, hoặc user của live session)
REMOTE_USER=caram

# VM không chạy trên libvirt (VirtualBox port-forward, máy thật...): chỉ định thẳng SSH
#REMOTE_HOST=127.0.0.1
#REMOTE_PORT=2222

# Cấu hình máy ảo cho make vm-create
#VM_ISO=/duong/dan/CaramOS-1.0.16-cinnamon-amd64.iso
#VM_MEMORY_MB=6144
#VM_CPUS=4
#VM_DISK_GB=40

# libvirt khác mặc định
#VIRSH_URI=qemu:///system
