#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:394
msgid "CaramOS update"
msgstr "Cập nhật CaramOS"

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:402
msgid ""
"Recommended: plug in the charger, keep a stable network connection and do "
"not turn off the computer during the update. You can close this window and "
"update later."
msgstr ""
"Khuyến nghị: cắm sạc, giữ kết nối mạng ổn định và không tắt máy trong lúc "
"cập nhật. Bạn có thể đóng cửa sổ này và cập nhật sau."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:407
msgid "Update now"
msgstr "Cập nhật ngay"

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:408
#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/install.py:138
msgid "Later"
msgstr "Để sau"

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:431
msgid "Updating"
msgstr "Đang cập nhật"

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:431
#: usr/lib/python3/dist-packages/caramos_ota_notifier/app.py:49
msgid "Updating CaramOS…"
msgstr "Đang cập nhật CaramOS..."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:432
msgid "Preparing the update…"
msgstr "Đang chuẩn bị cập nhật..."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:440
msgid "Update progress"
msgstr "Tiến trình cập nhật"

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:441
msgid "Please do not turn off the computer or close the update."
msgstr "Vui lòng không tắt máy hoặc đóng tiến trình cập nhật."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:450
msgid "Update complete!"
msgstr "Cập nhật thành công!"

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:450
msgid "CaramOS was updated successfully."
msgstr "CaramOS đã được cập nhật thành công."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:453
msgid "Update failed"
msgstr "Cập nhật thất bại"

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:454
msgid ""
"Something went wrong during the update. Try again or run sudo caramos-ota --"
"repair."
msgstr ""
"Đã xảy ra lỗi khi cập nhật. Vui lòng thử lại hoặc chạy sudo caramos-ota --"
"repair."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:457
msgid "Update details"
msgstr "Chi tiết cập nhật"

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:458
