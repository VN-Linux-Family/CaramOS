#: usr/lib/python3/dist-packages/caramos_business/health.py:104
#, python-format
msgid ""
"It may be a cloned disk: machines with the network cards %s report as this "
"one. Remove it, then pair each machine again."
msgstr ""
"Có thể là máy nhân bản: các máy có card mạng %s cùng báo về bằng mã của máy "
"này. Hãy gỡ máy, rồi ghép lại từng máy."

#: usr/lib/python3/dist-packages/caramos_business/health.py:110
#, python-format
msgid "The disk is almost full: %d%% free."
msgstr "Ổ đĩa sắp đầy: chỉ còn %d%% trống."

#: usr/lib/python3/dist-packages/caramos_business/health.py:112
msgid "A disk is failing: copy the files to a safe place and replace it."
msgstr "Ổ đĩa sắp hỏng: hãy chép tệp ra nơi an toàn rồi thay ổ."

#: usr/lib/python3/dist-packages/caramos_business/health.py:115
#, python-format
msgid "The battery is worn: it holds %d%% of its first charge."
msgstr "Pin đã chai: chỉ còn giữ được %d%% so với lúc mới."

#: usr/lib/python3/dist-packages/caramos_business/health.py:120
#, python-format
msgid "%(count)d security update has waited for %(time)s."
msgid_plural "%(count)d security updates have waited for %(time)s."
msgstr[0] "%(count)d bản vá bảo mật đã chờ %(time)s."

#: usr/lib/python3/dist-packages/caramos_business/health.py:124
#, python-format
msgid "It has needed a restart for %s."
msgstr "Máy cần khởi động lại đã %s."

#: usr/lib/python3/dist-packages/caramos_business/health.py:126
msgid "The firewall is off, though the company turns it on."
msgstr "Tường lửa đang tắt, dù công ty đã bật."

#: usr/lib/python3/dist-packages/caramos_business/health.py:130
#, python-format
msgid "%(section)s was not applied: %(reason)s"
msgstr "%(section)s: chưa áp dụng được, %(reason)s"

#: usr/lib/python3/dist-packages/caramos_business/health.py:135
#, python-format
msgid "Its clock is %s off."
msgstr "Đồng hồ của máy lệch %s."

#: usr/lib/python3/dist-packages/caramos_business/health.py:140
#, python-format
msgid "Its CaramOS Doanh nghiệp cannot apply %s yet: update the machine."
msgstr "%s: CaramOS Doanh nghiệp trên máy chưa hỗ trợ, hãy cập nhật máy."

#: usr/lib/python3/dist-packages/caramos_business/health.py:159
#, python-format
msgid "The last system snapshot is %s old."
msgstr "Bản lưu hệ thống gần nhất đã cũ %s."

#: usr/lib/python3/dist-packages/caramos_business/health.py:161
#, python-format
msgid "No system snapshot was taken in %s."
msgstr "Đã %s mà chưa có bản lưu hệ thống nào."

#: usr/lib/python3/dist-packages/caramos_business/health.py:166
#, python-format
msgid ""
"This frozen machine has had no maintenance for %s, so it misses its updates."
msgstr ""
"Máy đóng băng này đã %s không được bảo trì, nên đang lỡ các bản cập nhật."

#: usr/lib/python3/dist-packages/caramos_business/health.py:169
#, python-format
msgid ""
"This frozen machine has had no maintenance in the %s since it was frozen."
msgstr ""
"Máy đóng băng này chưa được bảo trì lần nào trong %s kể từ khi đóng băng."

#: usr/lib/python3/dist-packages/caramos_business/health.py:174
msgid "It needs a restart to start freezing."
msgstr "Máy cần khởi động lại để bắt đầu đóng băng."

#: usr/lib/python3/dist-packages/caramos_business/health.py:176
msgid "It needs a restart to stop freezing."
msgstr "Máy cần khởi động lại để thôi đóng băng."

#: usr/lib/python3/dist-packages/caramos_business/health.py:219
#, python-format
msgid "Not seen for %s."
msgstr "Đã %s không thấy báo về."

#: usr/lib/python3/dist-packages/caramos_business/helper.py:117
msgid "Unknown role."
msgstr "Vai trò không hợp lệ."

#: usr/lib/python3/dist-packages/caramos_business/helper.py:120
#: usr/lib/python3/dist-packages/caramos_business/helper.py:684
#: usr/lib/python3/dist-packages/caramos_business/helper.py:724
#: usr/lib/python3/dist-packages/caramos_business/helper.py:743
msgid "This machine is the admin machine already."
msgstr "Máy này đã là máy quản lý."

#: usr/lib/python3/dist-packages/caramos_business/helper.py:121
msgid ""
"This machine is an employee machine already: leave the admin machine first."
msgstr "Máy này đã là máy nhân viên: hãy rời máy quản lý trước."

#: usr/lib/python3/dist-packages/caramos_business/helper.py:128
#: usr/lib/python3/dist-packages/caramos_business/summaries.py:325
msgid "This machine became the admin machine."
msgstr "Máy này trở thành máy quản lý."

#: usr/lib/python3/dist-packages/caramos_business/helper.py:137
msgid "This machine is not the admin machine."
msgstr "Máy này không phải máy quản lý."

#: usr/lib/python3/dist-packages/caramos_business/helper.py:138
msgid "This machine is not an employee machine."
msgstr "Máy này không phải máy nhân viên."

#: usr/lib/python3/dist-packages/caramos_business/helper.py:166
#: usr/lib/python3/dist-packages/caramos_business/summaries.py:284
msgid "Adding machines opened for 10 minutes."
msgstr "Mở thêm máy trong 10 phút."

#: usr/lib/python3/dist-packages/caramos_business/helper.py:170
#: usr/lib/python3/dist-packages/caramos_business/summaries.py:285
msgid "Adding machines closed."
msgstr "Dừng thêm máy."

#: usr/lib/python3/dist-packages/caramos_business/helper.py:179
#: usr/lib/python3/dist-packages/caramos_business/summaries.py:249
#: usr/lib/python3/dist-packages/caramos_business/ui/adding.py:204
msgid "Each new machine now waits for approval."
msgstr "Từ giờ mỗi máy mới phải chờ duyệt."

#: usr/lib/python3/dist-packages/caramos_business/helper.py:180
#: usr/lib/python3/dist-packages/caramos_business/summaries.py:250
#: usr/lib/python3/dist-packages/caramos_business/ui/adding.py:205
msgid "New machines join without approval."
msgstr "Máy mới vào công ty không cần duyệt."

#: usr/lib/python3/dist-packages/caramos_business/helper.py:190
#: usr/lib/python3/dist-packages/caramos_business/helper.py:209
msgid "This machine is not waiting for approval."
msgstr "Máy này không ở trong danh sách chờ duyệt."

#: usr/lib/python3/dist-packages/caramos_business/helper.py:199
#: usr/lib/python3/dist-packages/caramos_business/summaries.py:252
#, python-format
msgid "%s was approved and joined the company."
msgstr "%s đã được duyệt và vào công ty."

#: usr/lib/python3/dist-packages/caramos_business/helper.py:211
#: usr/lib/python3/dist-packages/caramos_business/summaries.py:254
#: usr/lib/python3/dist-packages/caramos_business/ui/adding.py:87
#, python-format
msgid "%s was turned away."
msgstr "Đã từ chối %s."

#: usr/lib/python3/dist-packages/caramos_business/helper.py:223
msgid ""
"This machine has no network address: connect it to the company's network "
"first."
msgstr "Máy này chưa có địa chỉ mạng: hãy nối máy vào mạng của công ty trước."

#: usr/lib/python3/dist-packages/caramos_business/helper.py:231
#: usr/lib/python3/dist-packages/caramos_business/helper.py:234
msgid "Unknown enrolment file."
msgstr "Không có tệp ghép máy này."

#: usr/lib/python3/dist-packages/caramos_business/helper.py:235
#: usr/lib/python3/dist-packages/caramos_business/summaries.py:261
msgid "An enrolment file was withdrawn."
msgstr "Đã thu hồi một tệp ghép máy."

#: usr/lib/python3/dist-packages/caramos_business/helper.py:257
#: usr/lib/python3/dist-packages/caramos_business/helper.py:623
#: usr/lib/python3/dist-packages/caramos_business/ui/assets_page.py:416
#: usr/lib/python3/dist-packages/caramos_business/ui/machines.py:377
#: usr/lib/python3/dist-packages/caramos_business/ui/reports_page.py:75
#: usr/lib/python3/dist-packages/caramos_business/ui/tickets_page.py:140
#, python-format
msgid "Could not write %(file)s: %(error)s"
msgstr "Không ghi được %(file)s: %(error)s"

#: usr/lib/python3/dist-packages/caramos_business/helper.py:259
#: usr/lib/python3/dist-packages/caramos_business/summaries.py:257
#, python-format
msgid "An enrolment file was made: %(uses)d machines, until %(until)s."
msgstr "Đã tạo một tệp ghép máy: %(uses)d máy, dùng đến %(until)s."

#: usr/lib/python3/dist-packages/caramos_business/helper.py:271
#: usr/lib/python3/dist-packages/caramos_business/licences.py:138
#: usr/lib/python3/dist-packages/caramos_business/licences.py:142
msgid "The licence list could not be read."
msgstr "Không đọc được danh sách bản quyền."

#: usr/lib/python3/dist-packages/caramos_business/helper.py:275
#: usr/lib/python3/dist-packages/caramos_business/summaries.py:264
#, python-format
msgid "The list of bought licences was changed (%d entry)."
msgid_plural "The list of bought licences was changed (%d entries)."
msgstr[0] "Đã sửa danh sách bản quyền đã mua (%d mục)."

#: usr/lib/python3/dist-packages/caramos_business/helper.py:287
msgid "Unknown ticket."
msgstr "Không có phiếu hỗ trợ này."

#: usr/lib/python3/dist-packages/caramos_business/helper.py:291
#: usr/lib/python3/dist-packages/caramos_business/summaries.py:280
#, python-format
msgid "Ticket %s was changed."
msgstr "Đã cập nhật phiếu %s."

