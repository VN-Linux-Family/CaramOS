#!/bin/sh
set -e

case "$1" in
    remove|deconfigure)
        # Stop and disable the timer on removal
        if command -v systemctl >/dev/null 2>&1; then
            systemctl stop caramos-ota-check.timer || true
            systemctl disable caramos-ota-check.timer || true
        fi
        # Nemo goes back to its own menus (the Xsession.d file only points at menus that exist).
        /usr/share/caramos-ota/nemo-menu/caramos-nemo-menu --remove || true
        ;;
esac

#DEBHELPER#

exit 0
