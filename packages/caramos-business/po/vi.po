#, python-format
msgid ""
"A shared drive is an address like smb://server/folder, without %u and "
"without a password."
msgstr ""
"Ổ dùng chung là địa chỉ dạng smb://may-chu/thu-muc, không có %u và không kèm "
"mật khẩu."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:431
