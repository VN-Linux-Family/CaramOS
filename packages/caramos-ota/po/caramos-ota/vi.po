msgid "This is a virtual machine: graphics are not checked."
msgstr "Đây là máy ảo: không kiểm tra card đồ họa."

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/results.py:173
msgid "You are online now. Follow the steps below."
msgstr "Đã có mạng! Giờ hãy làm theo hướng dẫn bên dưới."

