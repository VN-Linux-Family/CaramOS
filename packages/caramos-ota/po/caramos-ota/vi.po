#: usr/share/caramos-ota/applets/caramos-help@caramos/applet.js:167
msgid "Ask for help"
msgstr "Nhờ giúp đỡ"

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:463
msgid "Ask for help sends VNLF what the update logged, for its team only."
msgstr "Nhờ giúp đỡ sẽ gửi VNLF nhật ký của bản cập nhật, chỉ đội VNLF xem."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:476
msgid "CaramOS is up to date"
msgstr "CaramOS đã là bản mới nhất"

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:477
msgid "The system runs the latest version in the stable update channel."
msgstr "Hệ thống đang dùng phiên bản mới nhất trong kênh cập nhật stable."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:478
msgid "Update status"
msgstr "Trạng thái cập nhật"

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:480
msgid "Latest version"
msgstr "Phiên bản mới nhất"

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:486
msgid ""
"There are no new migrations to install.\n"
"\n"
"You can close this window. CaramOS OTA keeps checking periodically with a "
"systemd timer."
msgstr ""
"Không có migration mới trong danh sách cập nhật.\n"
"\n"
"Bạn có thể đóng cửa sổ này. CaramOS OTA sẽ tiếp tục kiểm tra định kỳ bằng "
"systemd timer."

