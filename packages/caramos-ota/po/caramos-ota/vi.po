msgstr "CaramOS không tự cập nhật được"

#: usr/lib/python3/dist-packages/caramos_ota_notifier/auto_update.py:190
msgid "Open the Update Center to see what went wrong and to ask for help."
msgstr "Mở Trung tâm cập nhật để xem lỗi và nhờ giúp đỡ."

