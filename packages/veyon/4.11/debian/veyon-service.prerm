#! /bin/sh

# prerm script for veyon-service
#
# see: dh_installdeb(1)
#        * <prerm> `remove'
#        * <old-prerm> `upgrade' <new-version>
#        * <new-prerm> `failed-upgrade' <old-version>
#        * <conflictor's-prerm> `remove' `in-favour' <package> <new-version>
#        * <deconfigured's-prerm> `deconfigure' `in-favour'
#          <package-being-installed> <version> `removing'
#          <conflicting-package> <version>
# for details, see http://www.debian.org/doc/debian-policy/ or
# the debian-policy package

set -e

AUTH_HELPER=/usr/bin/veyon-auth-helper

case "$1" in
	remove)
		# drop the statoverride of veyon-auth-helper that veyon-service up to
		# 4.9 added, if it is still there
		if [ "$(dpkg-statoverride --list "$AUTH_HELPER" 2>/dev/null || true)" = "root root 4755 $AUTH_HELPER" ]; then
			dpkg-statoverride --remove "$AUTH_HELPER"
		fi
		# veyon-auth-helper.service is only started by D-Bus (no stop
		# generated by dh_installsystemd --no-start): stop a running one
		if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
			deb-systemd-invoke stop veyon-auth-helper.service >/dev/null || true
		fi
		;;

	deconfigure|upgrade|failed-upgrade)
		:
		;;

	*) echo "$0: didn't understand being called with \`$1'" 1>&2
		exit 1;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
