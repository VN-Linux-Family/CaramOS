#!/usr/bin/python3 -I
"""Files (Nemo) menus like Windows and the school textbooks: right-click > "Mới" > "Thư mục".

Nemo builds its menus from GtkUIManager XML compiled into libnemo-extension. This script reads that XML from the
installed library and writes changed copies to /var/lib/caramos-ota/nemo-menu:

- the view menus (right-click on an empty area, the desktop, the File menu) get "Create New Folder" as the first
  item of the "Create New Document" submenu, which /usr/share/locale/vi_VN/LC_MESSAGES/nemo.mo calls "Mới" with
  "Thư mục" inside (en: "New" > "Folder");
- the folder tree's menu drops its lone "Create New Folder", which would read "Thư mục" on its own there.

/etc/X11/Xsession.d/85caramos-nemo-menu points G_RESOURCE_OVERLAYS at the copies, so Nemo uses them from the next
login. When the XML is not shaped as expected (a Nemo update changed it), nothing is written and Nemo keeps its own
menus. The package runs this on install and whenever libnemo-extension changes (dpkg trigger).

The same library holds Nemo's CSS. The names under the icons of Cinnamon's desktop (nemo-desktop) have only a faint
shadow there, hard to read on light wallpapers, and Nemo loads that CSS at application priority, above any GTK theme,
so the theme cannot change them. This script also writes nemo-style-application.css with only that shadow made
stronger, the same as the Xfce edition's desktop names (xfce/panel-islands.css), and
/etc/X11/Xsession.d/85caramos-nemo-desktop-labels points Nemo at it from the next login. The menus and the CSS are
written or left out each on its own.
"""

from __future__ import annotations

import argparse
import glob
import os
import re
import sys
import tempfile
from pathlib import Path

OUT_DIR = Path("/var/lib/caramos-ota/nemo-menu")
LIBRARIES = "/usr/lib/*-linux-gnu/libnemo-extension.so.1"
VIEW = "/org/nemo/nemo-directory-view-ui.xml"
TREE = "/org/nemo/nemo-tree-sidebar-ui.xml"
STYLE = "/org/nemo/nemo-style-application.css"
# A GVDB file (GResource) starts with "GVariant", version 0 and options 0.
GVDB_HEADER = b"GVariant" + bytes(8)

VIEW_NEW_FOLDER = '<menuitem name="New Folder" action="New Folder"/>'
VIEW_NEW_DOCUMENTS = '<menu action="New Documents">'
TREE_NEW_FOLDER = '<menuitem name="NewFolder" action="New Folder"/>'

# Nemo's rule for the names under the desktop icons; its :hover and :selected rules (a highlight behind the name, no
# shadow) stay as they are.
DESKTOP_LABEL_RULE = re.compile(r"^\.nemo-desktop\.nemo-canvas-item\s*\{(?P<body>[^{}]*)\}", re.M)
TEXT_SHADOW = re.compile(r"text-shadow\s*:[^;{}]*;")
# The Xfce edition's (XfdesktopIconView.view.label in xfce/panel-islands.css): a dark shadow on every side and a soft
# drop below.
DESKTOP_LABEL_SHADOW = ("text-shadow: 0 1px 2px rgba(0, 0, 0, 0.85), 1px 0 2px rgba(0, 0, 0, 0.85), "
                        "-1px 0 2px rgba(0, 0, 0, 0.85), 0 -1px 2px rgba(0, 0, 0, 0.85), 0 2px 5px black;")
STYLE_HEADER = """/* CaramOS: Nemo's own nemo-style-application.css, read from {library} by
   /usr/share/caramos-ota/nemo-menu/caramos-nemo-menu, with only the shadow of the names under the desktop icons made
   stronger, like the Xfce edition's, so that they read on light wallpapers too. Nemo loads this CSS at application
   priority, above the GTK theme; /etc/X11/Xsession.d/85caramos-nemo-desktop-labels points Nemo here. */

"""


class MenuError(Exception):
    """The XML is not the one this script knows how to change."""


def view_menus(xml: str) -> str:
    """The File menu and the right-click menu: "New Folder" becomes the first item of "New Documents"."""

    if 'name="After New Folder"' in xml:
        raise MenuError("the view menus are changed already")
    if xml.count(VIEW_NEW_FOLDER) != 2 or xml.count(VIEW_NEW_DOCUMENTS) != 2:
        raise MenuError("the view menus do not have one New Folder and one New Documents in each of two places")
    changed = xml.replace(VIEW_NEW_FOLDER, "")
    changed = changed.replace(VIEW_NEW_DOCUMENTS, VIEW_NEW_DOCUMENTS + "\n\t\t\t\t" + VIEW_NEW_FOLDER
                              + '\n\t\t\t\t<separator name="After New Folder"/>')
    return changed


def tree_menu(xml: str) -> str:
    """The folder tree's right-click menu without its own "New Folder"."""

    if xml.count(TREE_NEW_FOLDER) != 1:
        raise MenuError("the folder tree menu does not have exactly one New Folder")
    return xml.replace(TREE_NEW_FOLDER, "")


CHANGES = {VIEW: view_menus, TREE: tree_menu}


def desktop_labels(css: str, library: Path) -> str:
    """Nemo's application CSS with the stronger shadow under the desktop icons' names, and nothing else changed."""

    if "/* CaramOS:" in css or DESKTOP_LABEL_SHADOW in css:
        raise MenuError("the desktop names are changed already")
    rules = list(DESKTOP_LABEL_RULE.finditer(css))
    if len(rules) != 1:
        raise MenuError("Nemo's CSS does not have one rule for the names under the desktop icons")
    body = rules[0].group("body")
    if len(TEXT_SHADOW.findall(body)) != 1:
        raise MenuError("Nemo's rule for the names under the desktop icons does not have one text-shadow")
    start, end = rules[0].span("body")
    changed = css[:start] + TEXT_SHADOW.sub(lambda _shadow: DESKTOP_LABEL_SHADOW, body) + css[end:]
    return STYLE_HEADER.format(library=library) + changed.rstrip("\n") + "\n"


def gio():
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib
    return Gio, GLib


def resources_in(data: bytes) -> list[object]:
    """Every GResource bundle compiled into a binary (the bytes from each GVDB header on)."""

    Gio, GLib = gio()
    found, start = [], 0
    while (at := data.find(GVDB_HEADER, start)) >= 0:
        start = at + 1
        try:
            found.append(Gio.Resource.new_from_data(GLib.Bytes.new(data[at:])))
        except GLib.Error:
            continue
    return found


def read_resources(library: Path, paths: list[str]) -> dict[str, str]:
    Gio, GLib = gio()
    wanted: dict[str, str] = {}
    for resource in resources_in(library.read_bytes()):
        for path in paths:
            if path in wanted:
                continue
            try:
                wanted[path] = resource.lookup_data(path, Gio.ResourceLookupFlags.NONE).get_data().decode("utf-8")
            except GLib.Error:
                continue
    missing = [path for path in paths if path not in wanted]
    if missing:
        raise MenuError(f"{library} has no {', '.join(missing)}")
    return wanted


def find_library() -> Path | None:
    libraries = sorted(glob.glob(LIBRARIES))
    return Path(libraries[0]) if libraries else None


def write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    handle, temporary = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    with os.fdopen(handle, "w", encoding="utf-8") as stream:
        stream.write(text)
    os.chmod(temporary, 0o644)
    os.replace(temporary, path)


def remove(out_dir: Path = OUT_DIR, resources: tuple[str, ...] = (*CHANGES, STYLE)) -> None:
    """Remove the changed copies (by default the menus and the CSS), so Nemo uses its own."""

    for path in resources:
        (out_dir / Path(path).name).unlink(missing_ok=True)


def update(library: Path | None, out_dir: Path = OUT_DIR) -> bool:
    """Write the changed menus; on any surprise remove them all so Nemo keeps its own. True when written."""

    try:
        if library is None:
            raise MenuError("Nemo is not installed")
        originals = read_resources(library, list(CHANGES))
        changed = {path: change(originals[path]) for path, change in CHANGES.items()}
    except (MenuError, OSError, ImportError, ValueError) as error:
        remove(out_dir, tuple(CHANGES))
        print(f"caramos-nemo-menu: Nemo keeps its own menus ({error})")
        return False
    for path, text in changed.items():
        write(out_dir / Path(path).name, text)
    print(f"caramos-nemo-menu: wrote the Mới > Thư mục menus to {out_dir} (from {library})")
    return True


def update_desktop_labels(library: Path | None, out_dir: Path = OUT_DIR) -> bool:
    """Write Nemo's CSS with the stronger shadow under the desktop icons; on any surprise remove it, so Nemo keeps its
    own. The menus are not touched either way. True when written."""

    target = out_dir / Path(STYLE).name
    try:
        if library is None:
            raise MenuError("Nemo is not installed")
        css = desktop_labels(read_resources(library, [STYLE])[STYLE], library)
    except (MenuError, OSError, ImportError, ValueError) as error:
        remove(out_dir, (STYLE,))
        print(f"caramos-nemo-menu: the names under the desktop icons keep Nemo's own shadow ({error})")
        return False
    write(target, css)
    print(f"caramos-nemo-menu: wrote the stronger shadow under the desktop icons to {target} (from {library})")
    return True


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--remove", action="store_true",
                        help="remove the changed menus and CSS (Nemo keeps its own)")
    parser.add_argument("--library", type=Path, help="libnemo-extension to read (default: the installed one)")
    parser.add_argument("--out", type=Path, default=OUT_DIR, help=argparse.SUPPRESS)
    args = parser.parse_args(argv)
    if args.remove:
        remove(args.out)
        return 0
    library = args.library or find_library()
    update(library, args.out)
    update_desktop_labels(library, args.out)
    return 0


if __name__ == "__main__":
    sys.exit(main())
