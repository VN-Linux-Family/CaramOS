#!/usr/bin/python3 -I
"""Put the document templates into the user's Templates folder, once per set of templates.

Files (Nemo) lists the files of that folder (~/Mẫu in Vietnamese) under right-click > "Mới", after "Thư mục", like
Windows' New > Microsoft Word Document, and each folder in it as a submenu. caramos-templates.timer runs this a
minute after login, when xdg-user-dirs has made the folder. Two sets:

- the empty Word, Excel, PowerPoint and text documents (templates/vi or templates/en), into the folder itself;
- the Vietnamese administrative documents of Nghị định 30/2020/NĐ-CP (templates/nd30, written by
  tools/make-nd30-templates.py), into a folder of their own: "Văn bản hành chính" in Vietnamese sessions,
  "Vietnamese Official Documents" in the others (the Xfce edition is English for schools, whose official
  documents are still Vietnamese, so the documents themselves keep their Vietnamese names).

Each set has its own record in ~/.local/state/caramos (templates.json for the first, as since 1.4.0), written once
the set is in. A set added by a later version therefore reaches existing users once, at their next login or when
the update starts this; the units run while a record is missing. Existing files are never replaced, and a user who
deletes the templates does not get them back.
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path
from typing import NamedTuple

TEMPLATES = Path("/usr/share/caramos-ota/templates")
STATE = Path(".local/state/caramos/templates.json")


class TemplateSet(NamedTuple):
    state: Path                        # under the home folder, written once the set is in
    source: str                        # folder in TEMPLATES; "{lang}" is the session's language
    subfolder: dict[str, str] | None = None   # folder inside Templates, by language; None: Templates itself


SETS = (
    TemplateSet(STATE, "{lang}"),
    TemplateSet(Path(".local/state/caramos/templates-nd30.json"), "nd30",
                {"vi": "Văn bản hành chính", "en": "Vietnamese Official Documents"}),
)


def language(environ: dict[str, str]) -> str:
    for name in ("LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG"):
        value = environ.get(name, "")
        if value:
            return "vi" if value.startswith("vi") else "en"
    return "en"


def user_dirs_file(home: Path, name: str) -> Path | None:
    """XDG_<NAME>_DIR from ~/.config/user-dirs.dirs, when xdg-user-dir is not installed."""

    try:
        lines = (home / ".config/user-dirs.dirs").read_text(encoding="utf-8").splitlines()
    except OSError:
        return None
    for line in lines:
        key, _, value = line.partition("=")
        if key.strip() == f"XDG_{name}_DIR":
            value = value.strip().strip('"').replace("$HOME", str(home))
            return Path(value)
    return None


def templates_dir(home: Path) -> Path | None:
    """The Templates folder, or None when there is none yet (xdg-user-dir then answers the home folder)."""

    try:
        result = subprocess.run(["xdg-user-dir", "TEMPLATES"], capture_output=True, text=True, check=False)
        path = Path(result.stdout.strip()) if result.returncode == 0 and result.stdout.strip() else None
    except OSError:
        path = user_dirs_file(home, "TEMPLATES")
    if path is None or not path.is_absolute() or path.resolve() == home.resolve():
        return None
    return path


def seed(source: Path, target: Path) -> list[str]:
    target.mkdir(parents=True, exist_ok=True)
    copied = []
    for template in sorted(source.iterdir()):
        destination = target / template.name
        if not template.is_file() or destination.exists():
            continue
        shutil.copyfile(template, destination)
        os.chmod(destination, 0o644)
        copied.append(template.name)
    return copied


def put_in(item: TemplateSet, home: Path, target: Path, lang: str, templates: Path) -> None:
    source = templates / item.source.format(lang=lang)
    if not source.is_dir():
        print(f"{source} is missing; trying again at the next login")
        return
    folder = target / item.subfolder.get(lang, item.subfolder["en"]) if item.subfolder else target
    record = {"language": lang, "folder": str(folder)}
    if os.path.lexists(folder) and not folder.is_dir():
        # A file of the user's where the folder would go: left alone, and not tried again.
        record.update(copied=[], error=f"{folder} is not a folder")
    else:
        record["copied"] = seed(source, folder)    # any other error: no record, so the next login tries again
    state = home / item.state
    state.parent.mkdir(parents=True, exist_ok=True)
    state.write_text(json.dumps(record, ensure_ascii=False, indent=1) + "\n", encoding="utf-8")
    copied = record["copied"]
    print(f"put {len(copied)} templates into {folder}" if copied else f"no new templates for {folder}")


def run(home: Path, environ: dict[str, str], templates: Path = TEMPLATES) -> int:
    pending = [item for item in SETS if not (home / item.state).exists()]
    if not pending:
        return 0
    target = templates_dir(home)
    if target is None:
        print("no Templates folder yet; trying again at the next login")
        return 0
    lang = language(environ)
    for item in pending:
        put_in(item, home, target, lang, templates)
    return 0


if __name__ == "__main__":
    sys.exit(run(Path.home(), dict(os.environ)))
