#: usr/lib/python3/dist-packages/caramos_business/admin.py:135
#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:140
msgid "A picture must be at most 20 MB."
msgstr "Ảnh tối đa 20 MB."

#: usr/lib/python3/dist-packages/caramos_business/admin.py:139
#: usr/lib/python3/dist-packages/caramos_business/ui/sections.py:142
msgid "Not a JPEG, PNG or WebP picture."
msgstr "Không phải ảnh JPEG, PNG hay WebP."

#: usr/lib/python3/dist-packages/caramos_business/admin.py:155
#: usr/lib/python3/dist-packages/caramos_business/helper.py:370
#: usr/lib/python3/dist-packages/caramos_business/protocol.py:404
#: usr/lib/python3/dist-packages/caramos_business/protocol.py:411
msgid "A picture is missing: choose it again."
msgstr "Thiếu một ảnh: hãy chọn lại."

#: usr/lib/python3/dist-packages/caramos_business/admin.py:158
msgid "A picture is damaged: choose it again."
msgstr "Một ảnh bị hỏng: hãy chọn lại."

#: usr/lib/python3/dist-packages/caramos_business/admin.py:239
msgid "The options could not be read."
msgstr "Không đọc được tùy chọn."

#: usr/lib/python3/dist-packages/caramos_business/admin.py:276
#: usr/lib/python3/dist-packages/caramos_business/admin.py:281
#: usr/lib/python3/dist-packages/caramos_business/helper.py:299
#: usr/lib/python3/dist-packages/caramos_business/helper.py:301
#: usr/lib/python3/dist-packages/caramos_business/helper.py:343
#: usr/lib/python3/dist-packages/caramos_business/helper.py:361
#: usr/lib/python3/dist-packages/caramos_business/helper.py:426
#: usr/lib/python3/dist-packages/caramos_business/helper.py:430
msgid "The settings could not be read."
msgstr "Không đọc được thiết lập."

#: usr/lib/python3/dist-packages/caramos_business/admin.py:317
msgid "A frozen machine needs a maintenance time, when it takes its updates."
msgstr "Máy đóng băng cần có giờ bảo trì, là lúc máy nhận bản cập nhật."

#: usr/lib/python3/dist-packages/caramos_business/admin.py:319
msgid ""
"Freezing and tidying Desktop and Documents onto the server cannot be on "
"together: the tidied files would come back at every reboot."
msgstr ""
"Không bật được cùng lúc đóng băng và dọn Màn hình nền, Tài liệu lên máy chủ: "
"các tệp đã dọn sẽ quay lại sau mỗi lần khởi động lại."

#: usr/lib/python3/dist-packages/caramos_business/admin.py:322
msgid ""
"Freezing and system snapshots cannot be on together: Timeshift would write "
"to the disk under the frozen system."
msgstr ""
"Không bật được cùng lúc đóng băng và bản lưu hệ thống: Timeshift sẽ ghi vào "
"ổ đĩa ngay dưới hệ thống đang đóng băng."

#: usr/lib/python3/dist-packages/caramos_business/admin.py:377
#: usr/lib/python3/dist-packages/caramos_business/draft.py:290
msgid ""
"A Wi-Fi password has 8 to 63 letters, digits or signs, without Vietnamese "
"accents."
msgstr ""
"Mật khẩu Wi-Fi có từ 8 đến 63 chữ cái, chữ số hoặc ký hiệu, không dấu tiếng "
"Việt."

#: usr/lib/python3/dist-packages/caramos_business/admin.py:383
#: usr/lib/python3/dist-packages/caramos_business/draft.py:287
#, python-format
msgid "Type the password of the Wi-Fi network “%s”."
msgstr "Hãy nhập mật khẩu của mạng Wi-Fi “%s”."

#: usr/lib/python3/dist-packages/caramos_business/admin.py:571
msgid "Taken out of the company."
msgstr "Đã gỡ khỏi công ty."

#: usr/lib/python3/dist-packages/caramos_business/admin.py:700
#: usr/lib/python3/dist-packages/caramos_business/assets.py:35
#: usr/lib/python3/dist-packages/caramos_business/assets.py:49
#: usr/lib/python3/dist-packages/caramos_business/assets.py:55
msgid "The asset details could not be read."
msgstr "Không đọc được thông tin tài sản."

#: usr/lib/python3/dist-packages/caramos_business/admin.py:705
msgid "A field is too long."
msgstr "Có một ô quá dài."

#: usr/lib/python3/dist-packages/caramos_business/admin.py:710
#: usr/lib/python3/dist-packages/caramos_business/assets.py:39
#: usr/lib/python3/dist-packages/caramos_business/licences.py:159
#: usr/lib/python3/dist-packages/caramos_business/ui/assets_page.py:145
msgid "Write dates as day/month/year, such as 15/3/2024."
msgstr "Ghi ngày theo dạng ngày/tháng/năm, ví dụ 15/3/2024."

#: usr/lib/python3/dist-packages/caramos_business/admin.py:714
#: usr/lib/python3/dist-packages/caramos_business/ui/assets_page.py:153
msgid "The price is a whole number of đồng."
msgstr "Giá là một số đồng, không có số lẻ."

#: usr/lib/python3/dist-packages/caramos_business/assets.py:44
msgid "Give the asset a name of at most 100 characters."
msgstr "Hãy đặt tên tài sản, tối đa 100 ký tự."

#: usr/lib/python3/dist-packages/caramos_business/backup.py:67
msgid "The passphrase needs at least 8 characters."
msgstr "Mật khẩu cần ít nhất 8 ký tự."

#: usr/lib/python3/dist-packages/caramos_business/backup.py:76
#: usr/lib/python3/dist-packages/caramos_business/helper.py:636
msgid "This is not a CaramOS Business backup."
msgstr "Đây không phải bản sao lưu của CaramOS Doanh nghiệp."

#: usr/lib/python3/dist-packages/caramos_business/backup.py:82
msgid "The passphrase is wrong, or the backup is damaged."
msgstr "Sai mật khẩu, hoặc bản sao lưu bị hỏng."

#: usr/lib/python3/dist-packages/caramos_business/backup.py:87
msgid "This machine has no admin key to back up."
msgstr "Máy này chưa có khóa của máy quản lý để sao lưu."

#: usr/lib/python3/dist-packages/caramos_business/backup.py:118
msgid "The backup is damaged."
msgstr "Bản sao lưu bị hỏng."

#: usr/lib/python3/dist-packages/caramos_business/backup.py:121
msgid "The backup has no admin key."
msgstr "Bản sao lưu không có khóa của máy quản lý."

#: usr/lib/python3/dist-packages/caramos_business/client.py:72
#: usr/lib/python3/dist-packages/caramos_business/pairing.py:311
msgid "The admin machine does not answer. Is it on, and on the same network?"
msgstr "Máy quản lý không trả lời. Máy đó có đang bật và cùng mạng không?"

#: usr/lib/python3/dist-packages/caramos_business/client.py:139
#: usr/lib/python3/dist-packages/caramos_business/ui/employee.py:521
msgid "The code has 6 digits."
msgstr "Mã gồm 6 chữ số."

#: usr/lib/python3/dist-packages/caramos_business/draft.py:196
#: usr/lib/python3/dist-packages/caramos_business/draft.py:213
msgid "A department's name has 1 to 60 characters."
msgstr "Tên phòng ban có từ 1 đến 60 ký tự."

#: usr/lib/python3/dist-packages/caramos_business/draft.py:198
msgid "At most 50 departments."
msgstr "Tối đa 50 phòng ban."

#: usr/lib/python3/dist-packages/caramos_business/draft.py:200
msgid "There is a department with this name already."
msgstr "Đã có phòng ban tên này."

#: usr/lib/python3/dist-packages/caramos_business/draft.py:236
msgid "Whole company"
msgstr "Cả công ty"

#: usr/lib/python3/dist-packages/caramos_business/draft.py:239
#, python-format
msgid "Machine %s"
msgstr "Máy %s"

#: usr/lib/python3/dist-packages/caramos_business/handover.py:44
#: usr/lib/python3/dist-packages/caramos_business/handover.py:48
msgid "The handover template is missing: reinstall CaramOS Doanh nghiệp."
msgstr "Thiếu mẫu biên bản bàn giao: hãy cài lại CaramOS Doanh nghiệp."

