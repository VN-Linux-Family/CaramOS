msgstr "Một ổ dùng chung bị ghi hai lần."

#: usr/lib/python3/dist-packages/caramos_business/protocol.py:435
#: usr/lib/python3/dist-packages/caramos_business/protocol.py:459
msgid "The browser settings are not valid."
msgstr "Thiết lập trình duyệt không hợp lệ."

