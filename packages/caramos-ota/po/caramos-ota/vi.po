#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:77
#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:81
#: usr/share/caramos-ota/applets/caramos-help@caramos/applet.js:168
msgid "Something does not work and you need advice"
msgstr "Có gì đó không chạy, bạn cần người chỉ cách"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:78
#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:82
msgid "What is the problem?"
msgstr "Bạn gặp vấn đề gì?"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:79
msgid ""
"For example: “After installing CaramOS the Wi-Fi does not show any networks. "
"I have a network cable but the laptop has no port.”"
msgstr ""
"Ví dụ: “Cài CaramOS xong Wi-Fi không thấy mạng nào. Mình có dây mạng nhưng "
"laptop không có cổng LAN.”"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:83
msgid ""
"For example: “Since this morning there is no sound, also with headphones. I "
"already restarted the computer.”"
msgstr ""
"Ví dụ: “Từ sáng máy không có tiếng, cắm tai nghe cũng vậy. Mình đã khởi động "
"lại máy.”"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:85
#: usr/share/caramos-ota/applets/caramos-help@caramos/applet.js:169
msgid "Report a bug"
msgstr "Báo lỗi"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:85
#: usr/share/caramos-ota/applets/caramos-help@caramos/applet.js:170
msgid "CaramOS or one of its apps does something wrong"
msgstr "CaramOS hoặc một ứng dụng của nó chạy sai"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:86
msgid "What went wrong?"
msgstr "Lỗi gì đã xảy ra?"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:87
msgid ""
"For example: “The Update Center stops halfway every time I install updates, "
"also after a restart.”"
msgstr ""
"Ví dụ: “Trung tâm cập nhật lần nào cũng dừng giữa chừng khi cài bản cập "
"nhật, khởi động lại máy vẫn vậy.”"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:89
#: usr/share/caramos-ota/applets/caramos-help@caramos/applet.js:171
msgid "Send feedback"
msgstr "Góp ý"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:89
#: usr/share/caramos-ota/applets/caramos-help@caramos/applet.js:172
msgid "An idea or a wish for CaramOS"
msgstr "Ý tưởng hoặc mong muốn cho CaramOS"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:90
msgid "What would you like to tell us?"
msgstr "Bạn muốn góp ý điều gì?"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:91
msgid ""
"For example: “I would like a quicker way to switch between Telex and VNI "
"typing.”"
msgstr "Ví dụ: “Mong có cách chuyển nhanh giữa kiểu gõ Telex và VNI.”"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:155
#: usr/share/caramos-ota/applets/caramos-help@caramos/applet.js:253
msgid "Write to the Vietnam Linux Family community"
msgstr "Gửi tới cộng đồng Vietnam Linux Family"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:156
msgid ""
"Ask for help, report a bug or share an idea. The CaramOS team and the VNLF "
"community read every request."
msgstr ""
"Nhờ giúp đỡ, báo lỗi hay góp ý: đội CaramOS và cộng đồng VNLF đọc mọi yêu "
"cầu."

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:160
msgid "Ask the VNLF community for help"
msgstr "Nhờ cộng đồng VNLF giúp đỡ"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:161
msgid ""
"Describe what is wrong. Your message goes to Vietnam Linux Family together "
"with this computer's hardware profile, so the people helping you see exactly "
"which hardware and drivers it has."
msgstr ""
"Hãy mô tả vấn đề bạn gặp. Lời nhắn được gửi tới Vietnam Linux Family cùng hồ "
"sơ phần cứng của máy, để người giúp bạn biết chính xác máy có phần cứng và "
"driver gì."

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:193
msgid "How can we reach you? (optional)"
msgstr "Liên lạc với bạn qua đâu? (không bắt buộc)"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:196
msgid "Email, Zalo number or Facebook link"
msgstr "Email, số Zalo hoặc link Facebook"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:198
msgid ""
"Only the VNLF team sees it. Without it, the answer is on your request's page."
msgstr ""
"Chỉ đội VNLF thấy thông tin này. Nếu bỏ trống, câu trả lời sẽ nằm ở trang "
"yêu cầu của bạn."

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:201
msgid ""
"Attach the hardware profile (hw-probe: 1–2 minutes, asks for your password)"
msgstr "Kèm hồ sơ phần cứng (hw-probe: mất 1–2 phút, cần nhập mật khẩu)"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:205
msgid "hw-probe is not installed. Install it with: sudo apt install hw-probe"
msgstr "Máy chưa cài hw-probe. Cài bằng lệnh: sudo apt install hw-probe"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:210
msgid ""
"The hardware profile (hw-probe) leaves out user names, the computer's name "
"and IP addresses; serial numbers and MAC addresses are only sent as hashes."
msgstr ""
"Hồ sơ phần cứng (hw-probe) không có tên người dùng, tên máy và địa chỉ IP; "
"số serial và địa chỉ MAC chỉ gửi dạng mã băm."

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:212
msgid "How hw-probe works"
msgstr "Tìm hiểu về hw-probe"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:216
msgid "Attach the Driver Check results"
msgstr "Kèm kết quả Kiểm tra driver"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:224
msgid ""
"Only the VNLF team sees the log, never the community. E-mail and IP "
"addresses, the computer's name and your user name are taken out."
msgstr ""
"Chỉ đội VNLF xem nhật ký, cộng đồng không thấy. Địa chỉ email, địa chỉ IP, "
"tên máy và tên người dùng của bạn đã được xoá khỏi nhật ký."

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:228
msgid "See what will be sent"
msgstr "Xem nội dung sẽ gửi"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:240
msgid "Let the VNLF community see it and help"
msgstr "Cho cộng đồng VNLF xem để cùng giúp"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:245
msgid "Your contact is not made public."
msgstr "Thông tin liên hệ không công khai."

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:249
msgid "Send"
msgstr "Gửi"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:253
msgid "Save the hardware profile"
msgstr "Lưu hồ sơ phần cứng"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:262
#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/requests.py:75
#: usr/share/caramos-ota/applets/caramos-help@caramos/applet.js:302
msgid "Your requests"
msgstr "Yêu cầu của bạn"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:312
#, python-format
msgid "Attach the logs (%s)"
msgstr "Kèm nhật ký (%s)"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:385
msgid ""
"No internet: get online first, or save the hardware profile and send it from "
"another device."
msgstr ""
"Chưa có mạng: hãy vào mạng trước, hoặc lưu hồ sơ phần cứng rồi gửi từ máy "
"khác."

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:388
msgid "No internet: connect to the internet to send it."
msgstr "Chưa có mạng: hãy kết nối Internet để gửi."

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:390
msgid "Reading this computer's details…"
msgstr "Đang đọc thông tin máy…"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:392
msgid "Write a few words about the problem to send it."
msgstr "Viết vài dòng về vấn đề để gửi."

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:394
msgid "The message is too long; keep it under 5000 characters."
msgstr "Lời nhắn quá dài, hãy viết dưới 5000 ký tự."

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:396
msgid "Recording the screen: stop it (Ctrl+Shift+Alt+R) to send the video."
msgstr "Đang quay màn hình: hãy dừng quay (Ctrl+Shift+Alt+R) để gửi kèm video."

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:398
msgid "Making the pictures and videos smaller…"
msgstr "Đang nén ảnh và video…"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:400
msgid "Ready to send."
msgstr "Sẵn sàng gửi."

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:405
msgid "(your message)"
msgstr "(lời nhắn của bạn)"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:453
msgid "Sending your request…"
msgstr "Đang gửi yêu cầu…"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:454
#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/report.py:49
msgid "Collecting hardware information…"
msgstr "Đang thu thập thông tin phần cứng…"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:454
#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:479
#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:520
msgid "Sending to VNLF…"
msgstr "Đang gửi tới VNLF…"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:501
#, python-format
msgid "Uploading the pictures and videos (%(number)d of %(count)d)…"
msgstr "Đang tải ảnh và video lên (%(number)d/%(count)d)…"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:547
msgid "The hardware profile was not made"
msgstr "Chưa tạo được hồ sơ phần cứng"

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:549
msgid ""
"hw-probe needs your password to read the hardware, and the password was not "
"entered."
msgstr ""
"hw-probe cần mật khẩu của bạn để đọc thông tin phần cứng, nhưng mật khẩu "
"chưa được nhập."

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:551
msgid ""
"hw-probe stopped before it was done. Check the internet connection and try "
"again."
msgstr ""
"hw-probe dừng lại trước khi chạy xong. Hãy kiểm tra kết nối mạng rồi thử lại."

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:553
msgid ""
"Your request has not been sent yet. Try again, or send it without the "
"hardware profile."
msgstr ""
"Yêu cầu của bạn chưa được gửi. Hãy thử lại, hoặc gửi mà không kèm hồ sơ phần "
"cứng."

#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:558
#: usr/share/caramos-ota/driver-check/caramos_driver_check/ui/help.py:584
msgid "Not sent yet"
