#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:210
#, python-format
msgid "You are using %s."
msgstr "Bạn đang dùng %s."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:213
#, python-format
msgid "This update has %d change for the version you have."
msgid_plural "This update has %d changes for the version you have."
msgstr[0] "Bản cập nhật này có %d thay đổi cho phiên bản bạn đang dùng."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:218
#, python-format
msgid "An update for CaramOS %s"
msgstr "Bản cập nhật cho CaramOS %s"

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:219
msgid "A new CaramOS update is available"
msgstr "CaramOS có bản cập nhật mới"

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:235
msgid "Size"
msgstr "Dung lượng"

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:238
msgid "Update channel"
msgstr "Kênh cập nhật"

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:245
#, python-format
msgid "Updating to CaramOS %s"
msgstr "Đang cập nhật lên CaramOS %s"

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:246
msgid "Updating CaramOS"
msgstr "Đang cập nhật CaramOS"

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:252
#, python-format
msgid "Updated to CaramOS %s"
msgstr "Đã cập nhật lên CaramOS %s"

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:253
#: usr/lib/python3/dist-packages/caramos_ota_notifier/auto_update.py:192
msgid "CaramOS was updated"
msgstr "Đã cập nhật CaramOS"

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:263
#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:308
#: usr/lib/python3/dist-packages/caramos_ota_notifier/auto_update.py:193
msgid "Some changes show after you log in again."
msgstr "Một số thay đổi sẽ hiện ra sau khi bạn đăng nhập lại."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:265
msgid "Not updated yet"
msgstr "Chưa cập nhật"

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:266
msgid "Updating needs the password of an administrator account."
msgstr "Cập nhật cần mật khẩu của tài khoản quản trị."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:267
msgid "Click Try again and type it when asked."
msgstr "Bấm Thử lại rồi nhập mật khẩu khi được hỏi."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:270
msgid "Another update is running"
msgstr "Đang có một lần cập nhật khác"

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:271
msgid ""
"CaramOS is already updating, in another Update Center window or in the "
"background."
msgstr ""
"CaramOS đang được cập nhật ở một cửa sổ Trung tâm cập nhật khác hoặc chạy "
"ngầm."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:272
msgid "Wait until it finishes, then click Try again."
msgstr "Đợi lần đó xong rồi bấm Thử lại."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:274
msgid "Click Ask for help to ask VNLF, with this update's log attached."
msgstr "Bấm Nhờ giúp đỡ để hỏi VNLF, kèm nhật ký của lần cập nhật này."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:275
msgid "Open the Update Center again later to try once more."
msgstr "Hãy mở lại Trung tâm cập nhật sau để thử lần nữa."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:276
msgid "Could not update"
msgstr "Chưa cập nhật được"

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:276
msgid "The update stopped because of an error."
msgstr "Bản cập nhật gặp lỗi nên đã dừng lại."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:282
msgid "Automatic updates"
msgstr "Tự động cập nhật"

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:282
msgid ""
"New versions of CaramOS install by themselves, and you are told when they "
"are done."
msgstr "Bản CaramOS mới tự cài khi có, xong sẽ báo cho bạn."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:289
msgid "It did not update by itself this time: the connection is metered."
msgstr "Lần này máy chưa tự cập nhật vì đang dùng mạng tính theo dung lượng."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:290
msgid ""
"It did not update by itself this time: the battery is low and the charger is "
"not plugged in."
msgstr "Lần này máy chưa tự cập nhật vì pin yếu và chưa cắm sạc."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:292
msgid "It did not update by itself this time: the disk is almost full."
msgstr "Lần này máy chưa tự cập nhật vì ổ đĩa sắp đầy."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:293
msgid ""
"It did not update by itself this time: another program was installing "
"software."
msgstr ""
"Lần này máy chưa tự cập nhật vì một chương trình khác đang cài phần mềm."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:295
msgid "It did not update by itself this time: another update was running."
msgstr "Lần này máy chưa tự cập nhật vì đang có một lần cập nhật khác chạy."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:296
msgid ""
"This update changes the desktop, so it does not install by itself while "
"someone is logged in."
msgstr ""
"Bản cập nhật này thay đổi màn hình làm việc nên không tự cài khi có người "
"đang đăng nhập."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:298
msgid "The last automatic try did not work. Click Update to try again."
msgstr "Lần tự cập nhật trước không thành công. Bấm Cập nhật để thử lại."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:299
msgid "The computer runs from a USB stick, so it does not update by itself."
msgstr "Máy đang chạy từ USB nên không tự cập nhật."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:300
msgid "The system drive is frozen, so the computer does not update by itself."
msgstr "Ổ hệ thống đang được đóng băng nên máy không tự cập nhật."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:308
#: usr/lib/python3/dist-packages/caramos_ota_notifier/auto_update.py:193
msgid "Restart to finish."
msgstr "Khởi động lại để hoàn tất."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:309
msgid "CaramOS installed this update by itself."
msgstr "CaramOS đã tự cài bản cập nhật này."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:314
#, python-format
msgid "You are using the latest version, %s."
msgstr "Bạn đang dùng bản mới nhất, %s."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:314
msgid "You are using the latest version."
msgstr "Bạn đang dùng bản mới nhất."

#: usr/lib/python3/dist-packages/caramos_ota_notifier/ui.py:315
msgid "The computer checks for new versions every day."
msgstr "Máy tự kiểm tra bản mới mỗi ngày."

